@model ListManager.Models.Circle

@{
    ViewData["Title"] = "Manage Circle";
}

<div class="card">
    <div class="card-body">
        <h2 class="card-title">Manage: @Model.Name</h2>

        <h4>Members</h4>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Joined</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var m in Model.Members)
            {
                <tr>
                    <td>@m.UserId</td>
                    <td>@m.JoinedDate.ToShortDateString()</td>
                    <td>
                        @if (Model.OwnerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <form asp-action="RemoveMember" method="post" class="d-inline">
                                <input type="hidden" name="circleId" value="@Model.CircleId" />
                                <input type="hidden" name="userId" value="@m.UserId" />
                                <button class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        }
                        @if (m.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value && Model.OwnerId != m.UserId)
                        {
                            <form asp-action="Leave" method="post" class="d-inline">
                                <input type="hidden" name="circleId" value="@Model.CircleId" />
                                <button class="btn btn-sm btn-outline-secondary">Leave</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <h4>Invitations</h4>
        <table class="table table-sm">
            <thead>
                <tr><th>Recipient</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var i in Model.Invitations)
            {
                <tr>
                    <td>@(i.RecipientEmail ?? i.RecipientId ?? "(unspecified)")</td>
                    <td>@(i.Accepted ? "Accepted" : "Pending")</td>
                    <td>
                        @if (!i.Accepted)
                        {
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Accept", "Circles", new { token = i.Token })">Accept Link</a>
                            @if (Model.OwnerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value || i.InviterId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                            {
                                <form asp-action="RemoveInvitation" method="post" class="d-inline">
                                    <input type="hidden" name="invitationId" value="@i.CircleInvitationId" />
                                    <button class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        }
                        else
                        {
                            <span>Accepted by: @i.RecipientId</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <h4>Invite</h4>
        <form asp-action="Invite" method="post" id="inviteForm">
            <input type="hidden" name="circleId" value="@Model.CircleId" />
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Recipient Email</label>
                    <input name="recipientEmail" class="form-control" type="email" placeholder="name@example.com" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Recipient UserId (optional)</label>
                    <input name="recipientId" class="form-control" />
                </div>
                <div class="col-md-2 align-self-end">
                    <button type="submit" class="btn btn-primary">Send Invite</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        // Simple client-side validation: require either email or userId
        document.getElementById('inviteForm').addEventListener('submit', function (e) {
            var email = document.querySelector('[name="recipientEmail"]').value.trim();
            var uid = document.querySelector('[name="recipientId"]').value.trim();
            if (!email && !uid) {
                e.preventDefault();
                alert('Please provide a recipient email or a recipient user id.');
            }
        });
    </script>
}
