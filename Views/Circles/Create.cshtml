@model ListManager.Models.Circle

@{
    ViewData["Title"] = SharedLocalizer["Circles.Create.Title"].Value;
}

<div class="card mx-auto" style="max-width:640px;">
    <div class="card-body">
        <h2 class="card-title">@SharedLocalizer["Circles.Create.Title"]</h2>
        <p class="text-muted">@SharedLocalizer["Circles.Create.Help"]</p>

        <form asp-action="Create" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" required />
                <div class="invalid-feedback">@SharedLocalizer["Circles.Create.InvalidName"]</div>
                <div class="text-danger"><span asp-validation-for="Name"></span></div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@SharedLocalizer["Common.Create"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@SharedLocalizer["Common.Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        // Bootstrap native validation styling
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
}
