@model ListManager.Models.CirclesIndexViewModel

@{
    ViewData["Title"] = SharedLocalizer["Circles.YourCircles"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="display-4 mb-0">@SharedLocalizer["Nav.Circles"]</h1>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-2" viewBox="0 0 16 16" aria-hidden="true">
            <path fill-rule="evenodd" d="M8 1a.5.5 0 0 1 .5.5V7.5H14a.5.5 0 0 1 0 1H8.5V14a.5.5 0 0 1-1 0V8.5H2a.5.5 0 0 1 0-1h5.5V1.5A.5.5 0 0 1 8 1z"/>
        </svg>
        @SharedLocalizer["Circles.Create.Title"]
    </a>
</div>

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["StatusMessage"]
    </div>
}

@if (Model.PendingInvitations.Any())
{
    <div class="card mb-4">
        <div class="card-header">
            <strong>@SharedLocalizer["Circles.PendingInvitations"]</strong>
        </div>
        <div class="card-body">
            <div class="list-group">
                @foreach (var invite in Model.PendingInvitations)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="mb-1">@invite.Circle?.Name</h5>
                                <p class="mb-1">@SharedLocalizer["Circles.InvitedBy"] @invite.InviterID</p>
                                <p class="mb-1 text-muted">@invite.RecipientEmail ?? invite.RecipientID</p>
                                <small>@SharedLocalizer["Circles.InvitedOn"] @invite.CreatedDate.ToString("g")</small>
                            </div>
                            <div class="btn-group btn-group-sm">
                                <form asp-action="AcceptInvite" method="post" class="me-1">
                                    <input type="hidden" name="invitationId" value="@invite.CircleInvitationID" />
                                    <button type="submit" class="btn btn-success">@SharedLocalizer["Common.Accept"]</button>
                                </form>
                                <form asp-action="RejectInvite" method="post">
                                    <input type="hidden" name="invitationId" value="@invite.CircleInvitationID" />
                                    <button type="submit" class="btn btn-outline-danger">@SharedLocalizer["Common.Reject"]</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="row g-3">
    @foreach (var c in Model.Circles)
    {
        <div class="col-sm-6 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@c.Name</h5>
                    <p class="card-text text-muted mb-1"><strong>@SharedLocalizer["Circles.Owner"]</strong> @c.OwnerID</p>
                    <p class="card-text text-muted mb-3"><strong>@SharedLocalizer["Circles.Members"]</strong> @(c.Members?.Count ?? 0)</p>

                    <div class="mt-auto">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Manage" asp-route-id="@c.CircleID">@SharedLocalizer["Common.Manage"]</a>
                        <a class="btn btn-sm btn-outline-secondary ms-2" asp-controller="Lists" asp-action="Circle" asp-route-id="@c.CircleID">@SharedLocalizer["Circles.ViewLists"]</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
