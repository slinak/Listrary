@model ListManager.Models.CirclesIndexViewModel

@{
    ViewData["Title"] = "Your Circles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Your Circles</h2>
    <a class="btn btn-primary" asp-action="Create">Create Circle</a>
</div>

@if (Model.PendingInvitations.Any())
{
    <div class="card mb-4">
        <div class="card-header">
            <strong>Pending Invitations</strong>
        </div>
        <div class="card-body">
            <div class="list-group">
                @foreach (var invite in Model.PendingInvitations)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="mb-1">@invite.Circle?.Name</h5>
                                <p class="mb-1">Invited by: @invite.InviterID</p>
                                <p class="mb-1 text-muted">@invite.RecipientEmail ?? invite.RecipientID</p>
                                <small>Invited on @invite.CreatedDate.ToString("g")</small>
                            </div>
                            <div class="btn-group btn-group-sm">
                                <form asp-action="AcceptInvite" method="post" class="me-1">
                                    <input type="hidden" name="invitationId" value="@invite.CircleInvitationID" />
                                    <button type="submit" class="btn btn-success">Accept</button>
                                </form>
                                <form asp-action="RejectInvite" method="post">
                                    <input type="hidden" name="invitationId" value="@invite.CircleInvitationID" />
                                    <button type="submit" class="btn btn-outline-danger">Reject</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="row g-3">
    @foreach (var c in Model.Circles)
    {
        <div class="col-sm-6 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@c.Name</h5>
                    <p class="card-text text-muted mb-1"><strong>Owner:</strong> @c.OwnerID</p>
                    <p class="card-text text-muted mb-3"><strong>Members:</strong> @(c.Members?.Count ?? 0)</p>

                    <div class="mt-auto">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Manage" asp-route-id="@c.CircleID">Manage</a>
                        <a class="btn btn-sm btn-outline-secondary ms-2" asp-controller="Lists" asp-action="Circle" asp-route-id="@c.CircleID">View Lists</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
