@model IEnumerable<ListManager.Models.Circle>

@{
    ViewData["Title"] = "Your Circles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Your Circles</h2>
    <a class="btn btn-primary" asp-action="Create">Create Circle</a>
</div>

<div class="row g-3">
    @foreach (var c in Model)
    {
        <div class="col-sm-6 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@c.Name</h5>
                    <p class="card-text text-muted mb-1"><strong>Owner:</strong> @c.OwnerID</p>
                    <p class="card-text text-muted mb-3"><strong>Members:</strong> @(c.Members?.Count ?? 0)</p>

                    <div class="mt-auto">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Manage" asp-route-id="@c.CircleID">Manage</a>
                        <a class="btn btn-sm btn-outline-secondary ms-2" asp-controller="Lists" asp-action="Circle" asp-route-id="@c.CircleID">View Lists</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
