@model ListManager.Models.CirclesIndexViewModel
@using ListManager.Models

@{
    ViewData["Title"] = SharedLocalizer["Circles.YourCircles"].Value;
    string IconClass(ListType? type) => type switch
    {
        ListType.Shopping => "list-icon-shopping",
        ListType.ToDo => "list-icon-todo",
        ListType.WishList => "list-icon-wishlist",
        _ => "list-icon-default"
    };
}

<div class="page-header">
    <h1 class="page-title">@SharedLocalizer["Nav.Circles"]<span class="page-count">@Model.Circles.Count()</span></h1>
    <a asp-action="Create" class="btn btn-primary page-primary-action" aria-label="@SharedLocalizer["Circles.Create.Title"]">
        <partial name="_Icon" model="@("plus")" />
        <span class="page-primary-label">@SharedLocalizer["Circles.Create.Title"]</span>
    </a>
</div>

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["StatusMessage"]</div>
}

@if (Model.Circles.Any())
{
    <div class="page-toolbar">
        <input type="search" id="entitySearch" class="form-control list-search" placeholder="@SharedLocalizer["Circles.Search.Placeholder"]" aria-label="@SharedLocalizer["Circles.Search.Placeholder"]" />
        <div class="d-flex flex-wrap gap-2 filter-pills" role="group">
            <button type="button" class="btn btn-sm rounded-pill filter-pill active" aria-pressed="true" data-entity-filter="all">@SharedLocalizer["Common.All"]</button>
            <button type="button" class="btn btn-sm rounded-pill filter-pill" aria-pressed="false" data-entity-filter="owned">@SharedLocalizer["Circles.Filter.Owned"]</button>
            <button type="button" class="btn btn-sm rounded-pill filter-pill" aria-pressed="false" data-entity-filter="joined">@SharedLocalizer["Circles.Filter.Joined"]</button>
        </div>
    </div>
}

@if (Model.PendingInvitations.Any())
{
    <section class="mb-4">
        <h2 class="section-heading mt-0">@SharedLocalizer["Circles.PendingInvitations"] <span class="count">(@Model.PendingInvitations.Count())</span></h2>
        <div class="d-flex flex-column gap-2">
            @foreach (var invite in Model.PendingInvitations)
            {
                <div class="card item-row">
                    <div class="card-body d-flex flex-wrap align-items-center gap-3 py-2">
                        <span class="list-icon list-icon-circle" aria-hidden="true"><partial name="_Icon" model="@("mail")" /></span>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-semibold text-truncate">@invite.Circle?.Name</div>
                            <div class="small text-body-secondary">
                                @SharedLocalizer["Circles.Invited"] <time datetime="@invite.CreatedDate.ToString("o")" data-relative-time>@invite.CreatedDate.ToString("g")</time>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <form asp-action="RejectInvite" method="post">
                                <input type="hidden" name="invitationId" value="@invite.CircleInvitationID" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@SharedLocalizer["Common.Reject"]</button>
                            </form>
                            <form asp-action="AcceptInvite" method="post">
                                <input type="hidden" name="invitationId" value="@invite.CircleInvitationID" />
                                <button type="submit" class="btn btn-sm btn-primary">@SharedLocalizer["Common.Accept"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (!Model.Circles.Any())
{
    <div class="empty-state text-center p-5">
        <h4>@SharedLocalizer["Circles.Empty.Title"]</h4>
        <p class="text-body-secondary mb-3">@SharedLocalizer["Circles.Empty.Body"]</p>
        <a asp-action="Create" class="btn btn-primary">@SharedLocalizer["Circles.Create.Title"]</a>
    </div>
}
else
{
    <section class="list-group-section">
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (var summary in Model.Circles)
            {
                var c = summary.Circle;
                var lists = summary.Lists.ToList();
                <div class="col entity-col" data-filter-name="@c.Name" data-filter-tags="@(summary.IsOwner ? "owned" : "joined")">
                    <div class="card list-card h-100 position-relative">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center gap-3">
                                <span class="list-icon list-icon-circle" aria-hidden="true"><partial name="_Icon" model="@("circles")" /></span>
                                <div class="flex-grow-1 min-w-0">
                                    <h5 class="card-title mb-1 text-truncate">
                                        <a asp-action="Manage" asp-route-id="@c.CircleID" class="stretched-link text-decoration-none list-card-link">@c.Name</a>
                                    </h5>
                                    <span class="badge rounded-pill @(summary.IsOwner ? "badge-tint-purple" : "badge-theme-neutral")">@SharedLocalizer[summary.IsOwner ? "Circles.Role.Owner" : "Circles.Role.Member"]</span>
                                </div>
                            </div>

                            @if (lists.Any())
                            {
                                <ul class="card-preview">
                                    @foreach (var list in lists.Take(ListViewItemModel.PreviewSize))
                                    {
                                        <li>
                                            <span class="list-icon @IconClass(list.ListModel!.ListType)" aria-hidden="true"><partial name="_ListTypeIcon" model="list.ListModel.ListType" /></span>
                                            <span>@list.ListModel.ListName</span>
                                            <span class="preview-count">@list.CompletedCount/@list.ItemCount</span>
                                        </li>
                                    }
                                    @if (lists.Count > ListViewItemModel.PreviewSize)
                                    {
                                        <li class="more">@SharedLocalizer["Circles.MoreLists", lists.Count - ListViewItemModel.PreviewSize]</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="small text-body-secondary mb-0">@SharedLocalizer["Lists.Circle.Empty"]</p>
                            }

                            <div class="mt-auto d-flex justify-content-between align-items-center gap-2 small text-body-secondary">
                                <partial name="_CircleAvatars" model="c" />
                                <time class="text-nowrap" datetime="@summary.LastActivity.ToString("o")" data-relative-time>@summary.LastActivity.ToString("MMM d, yyyy")</time>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
    <p id="entityNoMatches" class="text-center text-body-secondary d-none mt-3">@SharedLocalizer["Circles.NoMatches"]</p>
}
