@* "Add from screenshot" menu for one recipe text box; wired up by wwwroot/js/recipe-ocr.js. *@
<div class="dropdown">
    <button type="button" class="btn btn-link btn-sm text-decoration-none dropdown-toggle px-1" data-bs-toggle="dropdown" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/><path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1z"/></svg>
        @SharedLocalizer["Recipes.Screenshot.AddButton"]
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        <li><button type="button" class="dropdown-item" data-ocr-paste>@SharedLocalizer["Recipes.Screenshot.PasteButton"]</button></li>
        <li>
            <label class="dropdown-item mb-0" role="button">
                @SharedLocalizer["Recipes.Screenshot.ChooseButton"]
                <input type="file" accept="image/*" class="d-none" data-ocr-file />
            </label>
        </li>
    </ul>
</div>
