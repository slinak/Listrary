@model List<ListManager.Models.Recipe>

@{
    ViewData["Title"] = SharedLocalizer["Recipes.Title"].Value;
}

<h1 class="display-6">@SharedLocalizer["Recipes.Title"]</h1>

@if (TempData["RecipeError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form asp-action="Import" method="post" class="row g-2 mb-4">
    @Html.AntiForgeryToken()
    <div class="col-md-9">
        <input type="url" name="url" class="form-control" required placeholder="@SharedLocalizer["Recipes.UrlPlaceholder"]" />
        <small class="text-muted">@SharedLocalizer["Recipes.UrlHelp"]</small>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">@SharedLocalizer["Recipes.Import"]</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <p class="text-muted">@SharedLocalizer["Recipes.Empty"]</p>
}
else
{
    <div class="list-group">
        @foreach (var recipe in Model)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between" asp-action="Details" asp-route-id="@recipe.RecipeID">
                <span>@recipe.Title</span>
                <span class="badge bg-secondary">@recipe.Ingredients.Count</span>
            </a>
        }
    </div>
}
