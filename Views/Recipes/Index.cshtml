@model List<ListManager.Models.Recipe>

@{
    ViewData["Title"] = SharedLocalizer["Recipes.Title"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="display-4 mb-0">@SharedLocalizer["Recipes.Title"]</h1>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-2" viewBox="0 0 16 16" aria-hidden="true">
            <path fill-rule="evenodd" d="M8 1a.5.5 0 0 1 .5.5V7.5H14a.5.5 0 0 1 0 1H8.5V14a.5.5 0 0 1-1 0V8.5H2a.5.5 0 0 1 0-1h5.5V1.5A.5.5 0 0 1 8 1z"/>
        </svg>
        @SharedLocalizer["Recipes.Create.Title"]
    </a>
</div>

@if (TempData["RecipeError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@{
    var allTags = ViewBag.AllTags as List<string> ?? new List<string>();
    var selectedTag = ViewBag.SelectedTag as string;
}

@if (allTags.Count > 0 || selectedTag != null)
{
    <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 mb-3" role="search">
        <input type="search" name="tag" list="recipe-tag-options" class="form-control flex-grow-1 w-auto" style="min-width: 12rem; max-width: 24rem"
               value="@selectedTag" placeholder="@SharedLocalizer["Recipes.Tags.SearchPlaceholder"]" aria-label="@SharedLocalizer["Recipes.Tags.Search"]" />
        <datalist id="recipe-tag-options">
            @foreach (var tag in allTags)
            {
                <option value="@tag"></option>
            }
        </datalist>
        <button type="submit" class="btn btn-outline-primary">@SharedLocalizer["Recipes.Tags.Search"]</button>
        @if (selectedTag != null)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">@SharedLocalizer["Recipes.Tags.Clear"]</a>
        }
    </form>
}

@if (selectedTag != null && Model.Count == 0)
{
    <div class="empty-state text-center p-5 mb-4">
        <h4>@string.Format(SharedLocalizer["Recipes.Tags.NoMatches"].Value, selectedTag)</h4>
        <a asp-action="Index" class="btn btn-outline-secondary">@SharedLocalizer["Recipes.Tags.Clear"]</a>
    </div>
}
else if (Model.Count == 0)
{
    <div class="empty-state text-center p-5 mb-4">
        <h4>@SharedLocalizer["Recipes.Empty"]</h4>
        <p class="text-body-secondary">@SharedLocalizer["Recipes.Empty.Body"]</p>
        <a asp-action="Create" class="btn btn-primary">@SharedLocalizer["Recipes.Create.Title"]</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var recipe in Model)
        {
            <div class="col">
                <div class="card list-card h-100 position-relative">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-3 text-truncate">
                            <a asp-action="Details" asp-route-id="@recipe.RecipeID" class="stretched-link text-decoration-none list-card-link">@recipe.Title</a>
                        </h5>
                        @if (recipe.Tags.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var tag in recipe.Tags)
                                {
                                    <a asp-action="Index" asp-route-tag="@tag.Name"
                                       class="badge rounded-pill badge-theme-neutral text-decoration-none position-relative recipe-tag-link">@tag.Name</a>
                                }
                            </div>
                        }
                        <div class="mt-auto small text-body-secondary d-flex justify-content-between">
                            <span>@recipe.Ingredients.Count @SharedLocalizer[recipe.Ingredients.Count == 1 ? "Common.ItemSingular" : "Common.ItemPlural"]</span>
                            <time datetime="@recipe.CreatedDate.ToString("o")" data-relative-time>@recipe.CreatedDate.ToString("MMM d, yyyy")</time>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
