@using ListManager.Services
@model ListManager.Models.Recipe

@{
    ViewData["Title"] = Model.Title;

    // "For the Kebabs" → "Kebabs". Ingredients without a section get the generic "Ingredients" heading.
    string SectionHeading(string? section)
    {
        var heading = (section ?? string.Empty).Trim().TrimEnd(':').Trim();
        if (heading.Length == 0)
            return SharedLocalizer["Recipes.Ingredients"].Value;
        foreach (var prefix in new[] { "For the ", "For " })
        {
            if (heading.Length > prefix.Length && heading.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            {
                var rest = heading[prefix.Length..].TrimStart();
                return char.ToUpper(rest[0]) + rest[1..];
            }
        }
        return heading;
    }

    var ingredientGroups = Model.Ingredients
        .GroupBy(i => string.IsNullOrWhiteSpace(i.Section) ? string.Empty : i.Section.Trim())
        .ToList();
    var steps = RecipeInstructionParser.Parse(Model.Instructions);
    Uri? source = null;
    var hasSource = !string.IsNullOrEmpty(Model.SourceUrl) && Uri.TryCreate(Model.SourceUrl, UriKind.Absolute, out source)
        && (source.Scheme == Uri.UriSchemeHttp || source.Scheme == Uri.UriSchemeHttps);
}

<nav class="app-breadcrumb" aria-label="breadcrumb">
    <a asp-action="Index">@SharedLocalizer["Recipes.Title"]</a>
    <span class="sep" aria-hidden="true">›</span>
    <span aria-current="page">@Model.Title</span>
</nav>

@if (TempData["RecipeError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card detail-header">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3 min-w-0">
            <span class="list-icon list-icon-lg list-icon-recipe" aria-hidden="true"><partial name="_Icon" model="@("recipes")" /></span>
            <div class="min-w-0">
                <h1 class="detail-title text-break">@Model.Title</h1>
                <div class="detail-meta mt-1 d-flex flex-wrap align-items-center gap-2">
                    @if (hasSource)
                    {
                        <a href="@source" target="_blank" rel="noopener noreferrer" class="d-inline-flex align-items-center gap-1 text-decoration-none">
                            <partial name="_Icon" model="@("link")" />@source!.Host.Replace("www.", "")
                        </a>
                        <span aria-hidden="true">·</span>
                    }
                    <span>@Model.Ingredients.Count @SharedLocalizer["Recipes.Stats.Ingredients"] · @steps.Count @SharedLocalizer["Recipes.Stats.Steps"]</span>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (Model.Ingredients.Any())
            {
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createListModal">
                    <partial name="_Icon" model="@("cart")" /> <span class="ms-1">@SharedLocalizer["Recipes.MakeShoppingList"]</span>
                </button>
            }
            <div class="dropdown">
                <button class="btn btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@SharedLocalizer["Common.MoreActions"]">
                    <partial name="_Icon" model="@("dots")" />
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.RecipeID">@SharedLocalizer["Recipes.Edit"]</a></li>
                    <li><button type="button" class="dropdown-item" data-bs-toggle="collapse" data-bs-target="#addTagsPanel">@SharedLocalizer["Recipes.Tags.Add"]</button></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button type="button" class="dropdown-item text-danger confirm-delete-btn"
                                data-delete-url="@Url.Action("Delete", "Recipes", new { id = Model.RecipeID })"
                                data-delete-prompt="@SharedLocalizer["Recipes.DeletePrompt"]"
                                data-delete-name="@Model.Title">@SharedLocalizer["Recipes.Delete"]</button>
                    </li>
                </ul>
            </div>
        </div>

        <div class="w-100 d-flex flex-wrap align-items-center gap-2">
            @foreach (var tag in Model.Tags)
            {
                <span class="badge rounded-pill badge-theme-neutral d-inline-flex align-items-center gap-1 recipe-tag">
                    <a asp-action="Index" asp-route-tag="@tag.Name" class="text-reset text-decoration-none">@tag.Name</a>
                    <form asp-action="RemoveTag" asp-route-id="@Model.RecipeID" asp-route-tagId="@tag.RecipeTagID" method="post" class="d-inline m-0">
                        <button type="submit" class="btn-close recipe-tag-remove" aria-label="@SharedLocalizer["Recipes.Tags.Remove"] @tag.Name" title="@SharedLocalizer["Recipes.Tags.Remove"]"></button>
                    </form>
                </span>
            }
            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" data-bs-toggle="collapse" data-bs-target="#addTagsPanel" aria-expanded="false" aria-controls="addTagsPanel">+ @SharedLocalizer["Recipes.Tags.Add"]</button>
            <div class="collapse w-100" id="addTagsPanel">
                <form asp-action="AddTags" asp-route-id="@Model.RecipeID" method="post" class="d-flex gap-1 m-0" style="max-width: 24rem">
                    <input type="text" name="tags" class="form-control form-control-sm" maxlength="1000"
                           placeholder="@SharedLocalizer["Recipes.Tags.AddPlaceholder"]" aria-label="@SharedLocalizer["Recipes.Tags.Add"]" required />
                    <button type="submit" class="btn btn-outline-secondary btn-sm text-nowrap">@SharedLocalizer["Recipes.Tags.Add"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div data-recipe-view="ingredients">
    @if (ingredientGroups.Any() && steps.Any())
    {
        <div class="recipe-switch btn-group w-100 mb-2" role="group">
            <button type="button" class="btn btn-sm btn-outline-secondary active" aria-pressed="true" data-recipe-show="ingredients">@SharedLocalizer["Recipes.Ingredients"] (@Model.Ingredients.Count)</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" aria-pressed="false" data-recipe-show="steps">@SharedLocalizer["Recipes.Instructions"] (@steps.Count)</button>
        </div>
    }

    <div class="row g-4">
        @if (ingredientGroups.Any())
        {
            <div class="@(steps.Any() ? "col-md-5" : "col-12") recipe-pane-ingredients">
                @foreach (var group in ingredientGroups)
                {
                    <h2 class="section-heading">@SectionHeading(group.Key) <span class="count">(@group.Count())</span></h2>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var ingredient in group)
                        {
                            <div class="card item-row">
                                <div class="card-body d-flex align-items-center gap-3 py-2">
                                    <button type="button" class="item-check" data-ingredient-toggle aria-pressed="false" aria-label="@SharedLocalizer["Recipes.Ingredient.Toggle"]">
                                        <partial name="_Icon" model="@("check")" />
                                    </button>
                                    <div class="flex-grow-1 min-w-0 item-text text-break">@ingredient.Text</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (steps.Any())
        {
            <div class="@(ingredientGroups.Any() ? "col-md-7" : "col-12") recipe-pane-steps">
                <h2 class="section-heading">@SharedLocalizer["Recipes.Instructions"] <span class="count">(@steps.Count)</span></h2>
                <ol class="list-unstyled d-flex flex-column gap-2 mb-0">
                    @for (var i = 0; i < steps.Count; i++)
                    {
                        <li class="card item-row">
                            <div class="card-body d-flex align-items-start gap-3 py-2">
                                <span class="step-num" aria-hidden="true">@(i + 1)</span>
                                <div class="flex-grow-1 min-w-0 text-break">@steps[i]</div>
                            </div>
                        </li>
                    }
                </ol>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="createListModal" tabindex="-1" aria-labelledby="createListModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateList" asp-route-id="@Model.RecipeID" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createListModalLabel">@SharedLocalizer["Lists.Create.Title"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="listName">@SharedLocalizer["Lists.Fields.ListName"]</label>
                        <input type="text" id="listName" name="listName" class="form-control" maxlength="100" value="@Model.Title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="listType">@SharedLocalizer["Lists.Fields.ListType"]</label>
                        <select id="listType" name="listType" class="form-select">
                            @foreach (var type in Enum.GetValues<ListManager.Models.ListType>())
                            {
                                <option value="@type" selected="@(type == ListManager.Models.ListType.Shopping)">@type</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@SharedLocalizer["Common.Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@SharedLocalizer["Recipes.CreateList"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
