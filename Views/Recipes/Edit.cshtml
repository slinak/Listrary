@model ListManager.Models.RecipeFormModel

@{
    ViewData["Title"] = SharedLocalizer["Recipes.Edit.Title"].Value;
    var recipeId = (int)ViewBag.RecipeID;
    var detailsUrl = Url.Action("Details", new { id = recipeId });
}

<nav class="app-breadcrumb" aria-label="breadcrumb">
    <a asp-action="Index">@SharedLocalizer["Recipes.Title"]</a>
    <span class="sep" aria-hidden="true">›</span>
    <a href="@detailsUrl">@Model.Name</a>
    <span class="sep" aria-hidden="true">›</span>
    <span aria-current="page">@SharedLocalizer["Common.Edit"]</span>
</nav>

<div class="card form-card">
    <div class="card-body p-4">
        <h2 class="card-title mb-2">@SharedLocalizer["Recipes.Edit.Title"]</h2>
        <p class="text-muted mb-4">@SharedLocalizer["Recipes.Edit.Help"]</p>

        <partial name="_RecipeForm" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["FormAction"] = "Edit",
            ["RecipeID"] = recipeId,
            ["SubmitLabel"] = SharedLocalizer["Common.SaveChanges"].Value,
            ["CancelUrl"] = detailsUrl
        })" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js" crossorigin="anonymous"></script>
    <script src="~/js/recipe-ocr.js" asp-append-version="true"></script>
}
