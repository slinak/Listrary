@model ListManager.Models.RecipeFormModel

@{
    ViewData["Title"] = SharedLocalizer["Recipes.Create.Title"].Value;
}

<h1 class="display-6 mb-3">@SharedLocalizer["Recipes.Create.Title"]</h1>

@if (TempData["RecipeError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form asp-action="Import" method="post" class="row g-2 mb-4" id="recipe-import-form">
    @Html.AntiForgeryToken()
    <div class="col-md-9">
        <input type="url" name="url" class="form-control" required value="@(TempData["RecipeUrl"] as string)" placeholder="@SharedLocalizer["Recipes.UrlPlaceholder"]" />
        <small class="text-muted">@SharedLocalizer["Recipes.UrlHelp"]</small>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary">
            <span class="spinner-border spinner-border-sm me-1 d-none" role="status" aria-hidden="true"></span>
            @SharedLocalizer["Recipes.Import"]
        </button>
    </div>
</form>

<hr />

<form asp-action="Create" method="post" data-recipe-ocr data-messages="@Json.Serialize(new
{
    reading = SharedLocalizer["Recipes.Screenshot.Reading"].Value,
    done = SharedLocalizer["Recipes.Screenshot.Done"].Value,
    failed = SharedLocalizer["Recipes.Screenshot.Failed"].Value,
    unavailable = SharedLocalizer["Recipes.Screenshot.Unavailable"].Value,
    noText = SharedLocalizer["Recipes.Screenshot.NoText"].Value,
    notImage = SharedLocalizer["Recipes.Screenshot.NotImage"].Value,
    noImage = SharedLocalizer["Recipes.Screenshot.NoImage"].Value,
    clipboardDenied = SharedLocalizer["Recipes.Screenshot.ClipboardDenied"].Value
})">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">@SharedLocalizer["Recipes.Fields.Name"]</label>
        <input asp-for="Name" class="form-control" maxlength="200" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3" data-ocr-section="IngredientsText">
        <label asp-for="IngredientsText" class="form-label">@SharedLocalizer["Recipes.Ingredients"]</label>
        <partial name="_RecipeScreenshotInput" />
        <textarea asp-for="IngredientsText" class="form-control" rows="8" placeholder="@SharedLocalizer["Recipes.Screenshot.TextPlaceholder"]"></textarea>
        <small class="text-muted">@SharedLocalizer["Recipes.Screenshot.Help"]</small>
    </div>

    <div class="mb-3" data-ocr-section="Instructions">
        <label asp-for="Instructions" class="form-label">@SharedLocalizer["Recipes.Instructions"]</label>
        <partial name="_RecipeScreenshotInput" />
        <textarea asp-for="Instructions" class="form-control" rows="10" placeholder="@SharedLocalizer["Recipes.Instructions.Placeholder"]"></textarea>
        <small class="text-muted">@SharedLocalizer["Recipes.Instructions.Help"]</small>
    </div>

    <button type="submit" class="btn btn-primary">@SharedLocalizer["Common.Create"]</button>
    <a asp-action="Index" class="btn btn-outline-secondary">@SharedLocalizer["Common.Cancel"]</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js" crossorigin="anonymous"></script>
    <script src="~/js/recipe-ocr.js" asp-append-version="true"></script>
    <script>
        // Importing can take several seconds; show that something is happening.
        document.getElementById('recipe-import-form').addEventListener('submit', function (e) {
            var button = e.target.querySelector('button[type=submit]');
            button.disabled = true;
            button.querySelector('.spinner-border').classList.remove('d-none');
        });
    </script>
}
