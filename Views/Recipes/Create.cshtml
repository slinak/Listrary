@model ListManager.Models.RecipeFormModel

@{
    ViewData["Title"] = SharedLocalizer["Recipes.Create.Title"].Value;
}

<div class="card form-card">
    <div class="card-body p-4">
        <h2 class="card-title">@SharedLocalizer["Recipes.Create.Title"]</h2>
        <p class="text-muted mb-4">@SharedLocalizer["Recipes.Create.Help"]</p>

        @if (TempData["RecipeError"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <form asp-action="Import" method="post" class="form-card-subtle mb-4" id="recipe-import-form">
            <label for="recipe-url" class="form-label">@SharedLocalizer["Recipes.Import.Label"]</label>
            <div class="d-flex flex-wrap gap-2">
                <input type="url" id="recipe-url" name="url" class="form-control flex-grow-1 w-auto" style="min-width: 15rem" required
                       value="@(TempData["RecipeUrl"] as string)" placeholder="@SharedLocalizer["Recipes.UrlPlaceholder"]" />
                <button type="submit" class="btn btn-outline-primary">
                    <span class="spinner-border spinner-border-sm me-1 d-none" aria-hidden="true"></span>
                    @SharedLocalizer["Recipes.Import"]
                </button>
            </div>
            <div class="form-text">@SharedLocalizer["Recipes.Import.ScreenshotHint"]</div>
        </form>

        <partial name="_RecipeForm" view-data="@(new ViewDataDictionary(ViewData)
        {
            ["FormAction"] = "Create",
            ["ShowTags"] = true,
            ["SubmitLabel"] = SharedLocalizer["Common.Create"].Value,
            ["CancelUrl"] = Url.Action("Index")
        })" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js" crossorigin="anonymous"></script>
    <script src="~/js/recipe-ocr.js" asp-append-version="true"></script>
    <script src="~/js/recipe-tags.js" asp-append-version="true"></script>
    <script>
        // Importing can take several seconds; show that something is happening.
        document.getElementById('recipe-import-form').addEventListener('submit', function (e) {
            var button = e.target.querySelector('button[type=submit]');
            button.disabled = true;
            button.querySelector('.spinner-border').classList.remove('d-none');
        });
    </script>
}
