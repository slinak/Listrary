@model ListManager.Models.ListItemManagementViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Manage Items";

    string ToAnchorSlug(string value)
    {
        var builder = new System.Text.StringBuilder();

        foreach (var character in value)
        {
            if (char.IsLetterOrDigit(character))
            {
                builder.Append(char.ToLowerInvariant(character));
            }
            else if (builder.Length == 0 || builder[builder.Length - 1] != '-')
            {
                builder.Append('-');
            }
        }

        return builder.ToString().Trim('-');
    }

    string GetStoreLocationGroupKey(string? storeLocation)
    {
        return string.IsNullOrWhiteSpace(storeLocation)
            ? "__no_location__"
            : storeLocation.Trim().ToLowerInvariant();
    }

    string GetStoreLocationGroupLabel(string? storeLocation)
    {
        return string.IsNullOrWhiteSpace(storeLocation)
            ? "No store location"
            : storeLocation.Trim();
    }

    string GetStoreLocationSectionId(string? storeLocation)
    {
        var slug = ToAnchorSlug(GetStoreLocationGroupLabel(storeLocation));
        return string.IsNullOrWhiteSpace(slug) ? "group-no-store-location" : $"group-{slug}";
    }
}

<div class="row">
        @if (TempData["StoreLocationError"] is string storeLocationError && !string.IsNullOrWhiteSpace(storeLocationError))
        {
            <div class="alert alert-danger mb-3" role="alert">@storeLocationError</div>
        }
        @if (TempData["StoreLocationWarning"] is string storeLocationWarning && !string.IsNullOrWhiteSpace(storeLocationWarning))
        {
            <div class="alert alert-warning mb-3" role="alert">@storeLocationWarning</div>
        }

        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="mb-0">@Model.ListModel.ListName</h2>
                @if (Model.ListModel.StrictStoreLocations)
                {
                    <span class="badge bg-secondary mt-2">Strict store locations enabled</span>
                }
            </div>
            <div class="text-end">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Lists</a>
                @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.ListModel.OwnerID)
                {
                    <button type="button" class="btn btn-primary btn-sm ms-2" data-bs-toggle="modal" data-bs-target="#shareListModal">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-share me-2" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M13.5 1a1.5 1.5 0 1 0-1.415 2.096L6.9 6.12a1.5 1.5 0 0 0 0 3.76l5.185 3.024A1.5 1.5 0 1 0 13.5 15a1.5 1.5 0 0 0-1.415-2.096L7.9 9.88a.5.5 0 0 1 0-.76l4.185-2.44A1.5 1.5 0 0 0 13.5 1z"/>
                        </svg>
                        Share List
                    </button>
                }
            </div>
        </div>

        @if (Model.Items != null && Model.Items.Any())
        {
            var showStoreLocation = Model.Items.Any(i => !string.IsNullOrWhiteSpace(i.StoreLocation));
            var mobileSectionIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var mobileSections = new List<(string Id, string Label, bool IsCompleted)>();

            foreach (var item in Model.Items)
            {
                if (item.IsCompleted)
                {
                    const string completedSectionId = "group-completed";
                    if (mobileSectionIds.Add(completedSectionId))
                    {
                        mobileSections.Add((completedSectionId, "Completed Items", true));
                    }

                    continue;
                }

                var sectionId = GetStoreLocationSectionId(item.StoreLocation);
                if (mobileSectionIds.Add(sectionId))
                {
                    mobileSections.Add((sectionId, GetStoreLocationGroupLabel(item.StoreLocation), false));
                }
            }

            <div class="d-none d-md-block">
                <table class="table table-bordered table-striped align-middle">
                    <colgroup>
                        <col style="width: 25%" />
                        <col style="width: 25%" />
                        @if (showStoreLocation)
                        {
                            <col style="width: 20%" />
                        }
                        <col style="width: 15%" />
                        <col style="width: 30%" />
                    </colgroup>
                    <thead>
                        <tr class="tableHeadRow">
                            <th>Item</th>
                            <th>Details</th>
                            @if (showStoreLocation)
                            {
                                <th>Store Location</th>
                            }
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody class="tableBody">
                        @{
                            var previousIncompleteGroupKey = string.Empty;
                            var completedHeaderShown = false;
                        }
                        @foreach (var item in Model.Items)
                        {
                            if (!item.IsCompleted)
                            {
                                var currentGroupKey = GetStoreLocationGroupKey(item.StoreLocation);
                                if (currentGroupKey != previousIncompleteGroupKey)
                                {
                                    previousIncompleteGroupKey = currentGroupKey;
                                    <tr class="location-group-row">
                                        <td colspan="@(showStoreLocation ? 5 : 4)">
                                            <span class="location-group-label">@GetStoreLocationGroupLabel(item.StoreLocation)</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else if (!completedHeaderShown)
                            {
                                completedHeaderShown = true;
                                <tr class="location-group-row completed-group-row">
                                    <td colspan="@(showStoreLocation ? 5 : 4)">
                                        <span class="location-group-label">Completed Items</span>
                                    </td>
                                </tr>
                            }

                            <tr>
                                <td class="fw-semibold">@item.ItemName</td>
                                <td>@item.ItemDetails</td>
                                @if (showStoreLocation)
                                {
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.StoreLocation))
                                        {
                                            <span class="badge rounded-pill bg-light text-dark border">@item.StoreLocation</span>
                                        }
                                    </td>
                                }
                                <td>
                                    <span class="badge rounded-pill @(item.IsCompleted ? "text-bg-success" : "text-bg-warning")">
                                        @(item.IsCompleted ? "Completed" : "Active")
                                    </span>
                                </td>
                                <td>
                                    @if (Model.CanEdit)
                                    {
                                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                                            @using (Html.BeginForm("Toggle", "ListItem", FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.Hidden("listID", Model.ListModel.ListID)
                                                @Html.Hidden("listItemID", item.ListItemID)
                                                @Html.Hidden("shareToken", Model.ShareToken)
                                                <button type="submit" class="btn btn-sm @(item.IsCompleted ? "btn-outline-success" : "btn-outline-warning")">@(item.IsCompleted ? "Completed" : "Complete")</button>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-danger delete-list-item-btn"
                                                    data-list-id="@Model.ListModel.ListID"
                                                    data-list-item-id="@item.ListItemID"
                                                    data-list-item-name="@item.ItemName">Delete</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">View only</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-md-none">
                @if (mobileSections.Any())
                {
                    <div class="mobile-group-jump mb-3">
                        <div class="small text-muted mb-1">Jump to section</div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var navSection in mobileSections)
                            {
                                <a href="#@navSection.Id" class="btn btn-sm @(navSection.IsCompleted ? "btn-outline-success" : "btn-outline-primary") rounded-pill">@navSection.Label</a>
                            }
                        </div>
                    </div>
                }

                @{
                    var previousIncompleteGroupKeyMobile = string.Empty;
                    var completedHeaderShownMobile = false;
                }
                @foreach (var item in Model.Items)
                {
                    if (!item.IsCompleted)
                    {
                        var currentGroupKeyMobile = GetStoreLocationGroupKey(item.StoreLocation);
                        if (currentGroupKeyMobile != previousIncompleteGroupKeyMobile)
                        {
                            previousIncompleteGroupKeyMobile = currentGroupKeyMobile;
                            <div class="location-group-mobile" id="@GetStoreLocationSectionId(item.StoreLocation)">@GetStoreLocationGroupLabel(item.StoreLocation)</div>
                        }
                    }
                    else if (!completedHeaderShownMobile)
                    {
                        completedHeaderShownMobile = true;
                        <div class="location-group-mobile completed-group-mobile" id="group-completed">Completed Items</div>
                    }

                    <div class="card list-mobile-card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <h6 class="mb-0 fw-semibold">@item.ItemName</h6>
                                <span class="badge rounded-pill @(item.IsCompleted ? "text-bg-success" : "text-bg-warning")">
                                    @(item.IsCompleted ? "Completed" : "Active")
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.ItemDetails))
                            {
                                <p class="mb-2 text-muted">@item.ItemDetails</p>
                            }
                            @if (showStoreLocation && !string.IsNullOrWhiteSpace(item.StoreLocation))
                            {
                                <div class="mb-3">
                                    <span class="badge rounded-pill bg-light text-dark border">@item.StoreLocation</span>
                                </div>
                            }
                            <div>
                                @if (Model.CanEdit)
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @using (Html.BeginForm("Toggle", "ListItem", FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.Hidden("listID", Model.ListModel.ListID)
                                            @Html.Hidden("listItemID", item.ListItemID)
                                            @Html.Hidden("shareToken", Model.ShareToken)
                                            <button type="submit" class="btn btn-sm @(item.IsCompleted ? "btn-outline-success" : "btn-outline-warning")">@(item.IsCompleted ? "Completed" : "Complete")</button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-danger delete-list-item-btn"
                                                data-list-id="@Model.ListModel.ListID"
                                                data-list-item-id="@item.ListItemID"
                                                data-list-item-name="@item.ItemName">Delete</button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">View only</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="modal fade" id="deleteListItemModal" tabindex="-1" aria-labelledby="deleteListItemModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="deleteListItemModalLabel">Confirm Delete</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form asp-action="Delete" asp-controller="ListItem" method="post" id="deleteListItemForm">
                            <div class="modal-body">
                                <p>Are you sure you want to delete the item <strong id="deleteListItemName"></strong>?</p>
                                @Html.Hidden("listID", Model.ListModel.ListID, new { id = "deleteListItemListId" })
                                @Html.Hidden("listItemID", "", new { id = "deleteListItemId" })
                                @Html.Hidden("shareToken", Model.ShareToken)
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">This list has no items yet. Add your first item below.</div>
        }
        <div class="card mt-4">
            <div class="card-body">
                <h4 class="card-title">Add an Item</h4>
                @if (Model.CanEdit)
                {
                    @using (Html.BeginForm("Create", "ListItem", FormMethod.Post))
                    {
                        @Html.Hidden("listID", Model.ListModel.ListID)
                        @Html.Hidden("shareToken", Model.ShareToken)
                        <div class="form-group">
                            <label for="ItemName">Item Name</label>
                            @Html.TextBox("ItemName", Model.NewItem.ItemName, new { @class = "form-control", placeholder = "Name", autofocus = "autofocus", @list = "itemSuggestions" })
                            <datalist id="itemSuggestions"></datalist>
                        </div>
                        <div class="form-group mt-2">
                            <label for="ItemDetails">Details</label>
                            @Html.TextArea("ItemDetails", Model.NewItem.ItemDetails, 3, 0, new { @class = "form-control", placeholder = "Optional details, quantity, brand, etc" })
                        </div>
                        <div class="form-group mt-2">
                            <label for="StoreLocation">Store Location</label>
                            @Html.TextBox("StoreLocation", Model.NewItem.StoreLocation, new { @class = "form-control", placeholder = "Aisle 5, Produce, Frozen", @list = "storeLocationSuggestions" })
                            <datalist id="storeLocationSuggestions"></datalist>
                            @if (Model.ListModel.StrictStoreLocations)
                            {
                                <small class="text-muted">This list only accepts predefined store locations.</small>
                            }
                        </div>
                        <button type="submit" class="btn btn-success mt-3">Add Item</button>
                    }
                }
                else
                {
                    <div class="alert alert-secondary">This list is shared as view-only. Item changes are disabled.</div>
                }
            </div>
        </div>

        <!-- Share List Modal (contains the same share form formerly inline) -->
        <div class="modal fade" id="shareListModal" tabindex="-1" aria-labelledby="shareListModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="shareListModalLabel">Share this list</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form asp-action="Share" asp-controller="Lists" method="post" class="row gy-2 gx-2 align-items-end">
                            @Html.Hidden("id", Model.ListModel.ListID)
                            <div class="col-md-6">
                                <label class="form-label" for="permission">Permission</label>
                                <select class="form-select" id="permission" name="permission">
                                    <option value="View">View only</option>
                                    <option value="Edit">Edit</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary mt-1">Generate link</button>
                            </div>
                        </form>

                        @if (!string.IsNullOrEmpty(Model.GeneratedShareLink))
                        {
                            <div class="alert alert-success mt-3" role="alert">
                                Share link created. Send this URL to another user:
                                <div><a href="@Model.GeneratedShareLink" target="_blank">@Model.GeneratedShareLink</a></div>
                            </div>
                        }

                        @if (Model.ActiveShares != null && Model.ActiveShares.Any())
                        {
                            <div class="mt-3">
                                <h6>Active share links</h6>
                                <ul class="list-group">
                                    @foreach (var share in Model.ActiveShares)
                                    {
                                        <li class="list-group-item">
                                            <strong>@share.Permission</strong> link: <code>@Url.Action("Manage", "Lists", new { id = share.ListID, shareToken = share.Token }, Context.Request.Scheme)</code>
                                            @if (!string.IsNullOrEmpty(share.RecipientID))
                                            {
                                                <div><small>Accepted by: @share.RecipientID</small></div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModalElement = document.getElementById('deleteListItemModal');
            var deleteModal = new bootstrap.Modal(deleteModalElement);
            var deleteButtons = document.querySelectorAll('.delete-list-item-btn');
            var deleteListItemName = document.getElementById('deleteListItemName');
            var deleteListItemId = document.getElementById('deleteListItemId');

            deleteButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    deleteListItemName.textContent = button.getAttribute('data-list-item-name') || 'this item';
                    deleteListItemId.value = button.getAttribute('data-list-item-id');
                    deleteModal.show();
                });
            });

            // Auto-open share modal if a link was just generated or there are active shares
            var shouldOpenShareModal = @((!string.IsNullOrEmpty(Model.GeneratedShareLink) || (Model.ActiveShares != null && Model.ActiveShares.Any())) ? "true" : "false");
            if (shouldOpenShareModal === "true") {
                var shareModalEl = document.getElementById('shareListModal');
                if (shareModalEl) {
                    var shareModal = new bootstrap.Modal(shareModalEl);
                    shareModal.show();
                }
            }

            // Item name autocomplete
            var itemNameInput = document.querySelector('input[name="ItemName"]');
            var itemNameDatalist = document.getElementById('itemSuggestions');
            var storeLocationInput = document.querySelector('input[name="StoreLocation"]');
            var storeLocationDatalist = document.getElementById('storeLocationSuggestions');
            var itemNameDebounceTimer;
            var storeLocationDebounceTimer;
            var listID = @Model.ListModel.ListID;
            var shareToken = '@Model.ShareToken';
            var strictStoreLocations = @Model.ListModel.StrictStoreLocations.ToString().ToLowerInvariant();

            function buildSuggestionsUrl(basePath, parameters) {
                var url = basePath + '?listID=' + listID;

                Object.keys(parameters).forEach(function (key) {
                    var value = parameters[key];
                    if (value) {
                        url += '&' + key + '=' + encodeURIComponent(value);
                    }
                });

                if (shareToken) {
                    url += '&shareToken=' + encodeURIComponent(shareToken);
                }

                return url;
            }

            function renderDatalist(targetDatalist, suggestions) {
                targetDatalist.innerHTML = '';
                suggestions.forEach(function (suggestion) {
                    var option = document.createElement('option');
                    option.value = suggestion;
                    targetDatalist.appendChild(option);
                });
            }

            if (itemNameInput && itemNameDatalist) {
                itemNameInput.addEventListener('input', function () {
                    clearTimeout(itemNameDebounceTimer);
                    var query = this.value.trim();

                    if (query.length === 0) {
                        itemNameDatalist.innerHTML = '';
                        if (storeLocationDatalist) {
                            storeLocationDatalist.innerHTML = '';
                        }
                        return;
                    }

                    itemNameDebounceTimer = setTimeout(function () {
                        var url = buildSuggestionsUrl('/ListItem/GetItemNameSuggestions', { query: query });

                        fetch(url)
                            .then(response => response.json())
                            .then(suggestions => {
                                renderDatalist(itemNameDatalist, suggestions);
                            })
                            .catch(error => console.error('Error fetching item name suggestions:', error));
                    }, 300);
                });
            }

            if (itemNameInput && storeLocationInput && storeLocationDatalist) {
                function fetchStoreLocationSuggestions() {
                    var itemName = itemNameInput.value.trim();
                    var query = storeLocationInput.value.trim();

                    if (itemName.length === 0) {
                        storeLocationDatalist.innerHTML = '';
                        return;
                    }

                    var url = buildSuggestionsUrl('/ListItem/GetStoreLocationSuggestions', {
                        itemName: itemName,
                        query: query
                    });

                    fetch(url)
                        .then(response => response.json())
                        .then(suggestions => {
                            renderDatalist(storeLocationDatalist, suggestions);

                            if (strictStoreLocations && suggestions.length > 0 && storeLocationInput.value.trim().length === 0) {
                                storeLocationInput.value = suggestions[0];
                            }
                        })
                        .catch(error => console.error('Error fetching store location suggestions:', error));
                }

                itemNameInput.addEventListener('change', function () {
                    clearTimeout(storeLocationDebounceTimer);
                    storeLocationDebounceTimer = setTimeout(fetchStoreLocationSuggestions, 150);
                });

                itemNameInput.addEventListener('blur', function () {
                    clearTimeout(storeLocationDebounceTimer);
                    storeLocationDebounceTimer = setTimeout(fetchStoreLocationSuggestions, 150);
                });

                storeLocationInput.addEventListener('focus', function () {
                    clearTimeout(storeLocationDebounceTimer);
                    storeLocationDebounceTimer = setTimeout(fetchStoreLocationSuggestions, 150);
                });

                storeLocationInput.addEventListener('input', function () {
                    clearTimeout(storeLocationDebounceTimer);
                    storeLocationDebounceTimer = setTimeout(fetchStoreLocationSuggestions, 250);
                });
            }
        });
    </script>
}
