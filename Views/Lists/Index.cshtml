@model ListManager.Models.ListsIndexViewModel

@{
    ViewData["Title"] = SharedLocalizer["Nav.Lists"].Value;
    var hasAnyLists = Model.CircleGroups.Any(g => g.Lists.Any()) || Model.OtherLists.Any();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="display-4 mb-0">@SharedLocalizer["Nav.Lists"]</h1>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-2" viewBox="0 0 16 16" aria-hidden="true">
            <path fill-rule="evenodd" d="M8 1a.5.5 0 0 1 .5.5V7.5H14a.5.5 0 0 1 0 1H8.5V14a.5.5 0 0 1-1 0V8.5H2a.5.5 0 0 1 0-1h5.5V1.5A.5.5 0 0 1 8 1z"/>
        </svg>
        @SharedLocalizer["Lists.Create.Title"]
    </a>
</div>

@if (hasAnyLists)
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <input type="search" id="listSearch" class="form-control list-search" placeholder="@SharedLocalizer["Lists.Search.Placeholder"]" aria-label="@SharedLocalizer["Lists.Search.Placeholder"]" />
        <div class="d-flex flex-wrap gap-2" role="group">
            <button type="button" class="btn btn-sm rounded-pill filter-pill active" data-list-filter="all">@SharedLocalizer["Common.All"]</button>
            <button type="button" class="btn btn-sm rounded-pill filter-pill" data-list-filter="Shopping">Shopping</button>
            <button type="button" class="btn btn-sm rounded-pill filter-pill" data-list-filter="ToDo">ToDo</button>
            <button type="button" class="btn btn-sm rounded-pill filter-pill" data-list-filter="WishList">WishList</button>
        </div>
    </div>
}
else
{
    <div class="empty-state text-center p-5 mb-4">
        <h4>@SharedLocalizer["Lists.Empty.Title"]</h4>
        <p class="text-body-secondary">@SharedLocalizer["Lists.Empty.Body"]</p>
        <a asp-action="Create" class="btn btn-primary">@SharedLocalizer["Lists.Create.Title"]</a>
    </div>
}

@{
    var sectionIndex = 0;
}

@foreach (var group in Model.CircleGroups)
{
    var sectionId = $"listSection{sectionIndex++}";
    <section class="list-group-section mb-4">
        <div class="list-section-header d-flex justify-content-between align-items-center">
            <button class="btn list-section-toggle d-flex align-items-center gap-2 fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#@sectionId" aria-expanded="true" aria-controls="@sectionId">
                <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"/></svg>
                <span>@SharedLocalizer["Lists.CirclePrefix"] @group.Circle.Name</span>
                <span class="text-body-secondary fw-normal">(@group.Lists.Count())</span>
            </button>
            <a asp-action="Circle" asp-route-id="@group.Circle.CircleID" class="btn btn-sm btn-outline-primary">@SharedLocalizer["Circles.ViewCircle"]</a>
        </div>
        <div class="collapse show" id="@sectionId">
            @if (!group.Lists.Any())
            {
                <p class="text-body-secondary mt-3 mb-0">@SharedLocalizer["Lists.Circle.Empty"]</p>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-0">
                    @foreach (var item in group.Lists)
                    {
                        <partial name="_ListCard" model="item" />
                    }
                </div>
            }
        </div>
    </section>
}

@if (Model.OtherLists.Any())
{
    var sectionId = $"listSection{sectionIndex++}";
    <section class="list-group-section mb-4">
        <div class="list-section-header">
            <button class="btn list-section-toggle d-flex align-items-center gap-2 fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#@sectionId" aria-expanded="true" aria-controls="@sectionId">
                <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"/></svg>
                <span>@SharedLocalizer["Lists.YourLists"]</span>
                <span class="text-body-secondary fw-normal">(@Model.OtherLists.Count())</span>
            </button>
        </div>
        <div class="collapse show" id="@sectionId">
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-0">
                @foreach (var item in Model.OtherLists)
                {
                    <partial name="_ListCard" model="item" />
                }
            </div>
        </div>
    </section>
}

<p id="listNoMatches" class="text-center text-body-secondary d-none">@SharedLocalizer["Lists.NoMatches"]</p>

<partial name="_DeleteListModal" />
