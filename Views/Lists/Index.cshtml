@model List<ListManager.Models.List>

@{
    ViewData["Title"] = "Lists";
}

<div class="text-center">
    <h1 class="display-4">Your Lists</h1>
</div>
<table class="table">
    @foreach (var item in Model)
    {
        <tr>
            <th>List Name</th>
            <th>List Type</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
        <tr>
            <td>@item.ListName</td>
            <td>@item.ListType</td>
            <td>@item.CreatedDate</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ListID">Manage</a> | 
                <a asp-action="Delete" asp-route-id="@item.ListID">Delete</a>
            </td>
        </tr>
    }
</table>