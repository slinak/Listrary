@model IEnumerable<ListManager.Models.ListViewItemModel>

@{
    ViewData["Title"] = "Lists";
}

<div class="text-center">
    <h1 class="display-4">Your Lists</h1>
</div>
<table class="table">
    <thead>
        <tr>
            <th>List Name</th>
            <th>List Type</th>
            <th>Items</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ListModel!.ListName</td>
            <td>@item.ListModel!.ListType</td>
            <td>@item.ItemCount</td>
            <td>@item.ListModel!.CreatedDate</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ListModel!.ListID">Edit</a> | 
                <a asp-action="Manage" asp-route-id="@item.ListModel!.ListID">Manage</a> |
                @using (Html.BeginForm("Delete", "Lists", FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.Hidden("id", item.ListModel!.ListID)
                    <button type="submit" class="btn btn-link p-0" style="color: inherit; text-decoration: underline; border: none; background: none; cursor: pointer;">Delete</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>