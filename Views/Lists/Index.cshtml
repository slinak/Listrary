@model ListManager.Models.ListsIndexViewModel

@{
    ViewData["Title"] = SharedLocalizer["Nav.Lists"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="display-4 mb-0">@SharedLocalizer["Nav.Lists"]</h1>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-2" viewBox="0 0 16 16" aria-hidden="true">
            <path fill-rule="evenodd" d="M8 1a.5.5 0 0 1 .5.5V7.5H14a.5.5 0 0 1 0 1H8.5V14a.5.5 0 0 1-1 0V8.5H2a.5.5 0 0 1 0-1h5.5V1.5A.5.5 0 0 1 8 1z"/>
        </svg>
        @SharedLocalizer["Lists.Create.Title"]
    </a>
</div>

@{
    string GetListTypeBadgeClass(ListManager.Models.ListType? listType)
    {
        return listType switch
        {
            ListManager.Models.ListType.Shopping => "badge-listtype-shopping",
            ListManager.Models.ListType.ToDo => "badge-listtype-todo",
            ListManager.Models.ListType.WishList => "badge-listtype-wishlist",
            _ => "badge-listtype-default"
        };
    }
}

@foreach (var group in Model.CircleGroups)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <strong>@SharedLocalizer["Lists.CirclePrefix"] @group.Circle.Name</strong>
                <span class="badge bg-secondary ms-2">@group.Lists.Count() @SharedLocalizer[group.Lists.Count() == 1 ? "Common.ListSingular" : "Common.ListPlural"]</span>
            </div>
            <a asp-action="Circle" asp-route-id="@group.Circle.CircleID" class="btn btn-sm btn-outline-primary">@SharedLocalizer["Circles.ViewCircle"]</a>
        </div>
        <div class="card-body">
            @if (!group.Lists.Any())
            {
                <p class="text-muted mb-0">@SharedLocalizer["Lists.Circle.Empty"]</p>
            }
            else
            {
                <div class="d-none d-md-block">
                    <table class="table mb-0 text-center align-middle">
                        <colgroup>
                            <col style="width:20%" />
                            <col style="width:20%" />
                            <col style="width:20%" />
                            <col style="width:20%" />
                            <col style="width:20%" />
                        </colgroup>
                        <thead>
                            <tr class="tableHeadRow">
                                <th>@SharedLocalizer["Lists.Fields.ListName"]</th>
                                <th>@SharedLocalizer["Lists.Fields.ListType"]</th>
                                <th>@SharedLocalizer["Lists.Fields.Items"]</th>
                                <th>@SharedLocalizer["Lists.Fields.CreatedDate"]</th>
                                <th>@SharedLocalizer["Lists.Fields.Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in group.Lists)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.ListModel!.ListName</td>
                                    <td>
                                        <span class="badge rounded-pill @GetListTypeBadgeClass(item.ListModel!.ListType)">@item.ListModel!.ListType</span>
                                    </td>
                                        <td><span class="badge rounded-pill bg-primary">@item.ItemCount @SharedLocalizer[item.ItemCount == 1 ? "Common.ItemSingular" : "Common.ItemPlural"]</span></td>
                                    <td>@item.ListModel!.CreatedDate.ToString("MMM d, yyyy")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm list-action-group" role="group" aria-label="@SharedLocalizer["Lists.ActionsAria"]">
                                            <a asp-action="Manage" asp-route-id="@item.ListModel!.ListID" class="btn btn-outline-primary">@SharedLocalizer["Common.View"]</a>
                                            <a asp-action="Edit" asp-route-id="@item.ListModel!.ListID" class="btn btn-outline-secondary">@SharedLocalizer["Common.Edit"]</a>
                                            <button type="button" class="btn btn-outline-danger delete-list-btn"
                                                    data-list-id="@item.ListModel!.ListID"
                                                    data-list-name="@item.ListModel!.ListName">@SharedLocalizer["Common.Delete"]</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-md-none">
                    @foreach (var item in group.Lists)
                    {
                        <div class="card list-mobile-card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h6 class="mb-0 fw-semibold">@item.ListModel!.ListName</h6>
                                        <span class="badge rounded-pill bg-primary">@item.ItemCount @SharedLocalizer[item.ItemCount == 1 ? "Common.ItemSingular" : "Common.ItemPlural"]</span>
                                </div>
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="badge rounded-pill @GetListTypeBadgeClass(item.ListModel!.ListType)">@item.ListModel!.ListType</span>
                                    <span class="badge rounded-pill badge-theme-neutral">@item.ListModel!.CreatedDate.ToString("MMM d, yyyy")</span>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-action="Manage" asp-route-id="@item.ListModel!.ListID" class="btn btn-sm btn-outline-primary">@SharedLocalizer["Common.View"]</a>
                                    <a asp-action="Edit" asp-route-id="@item.ListModel!.ListID" class="btn btn-sm btn-outline-secondary">@SharedLocalizer["Common.Edit"]</a>
                                    <button type="button" class="btn btn-sm btn-outline-danger delete-list-btn"
                                            data-list-id="@item.ListModel!.ListID"
                                            data-list-name="@item.ListModel!.ListName">@SharedLocalizer["Common.Delete"]</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@if (Model.OtherLists.Any())
{
    <div class="card mb-4">
        <div class="card-header">
            <strong>@SharedLocalizer["Lists.YourLists"]</strong>
        </div>
        <div class="card-body">
            <div class="d-none d-md-block">
                <table class="table mb-0 text-center align-middle">
                    <colgroup>
                        <col style="width:20%" />
                        <col style="width:20%" />
                        <col style="width:20%" />
                        <col style="width:20%" />
                        <col style="width:20%" />
                    </colgroup>
                    <thead>
                        <tr class="tableHeadRow">
                            <th>@SharedLocalizer["Lists.Fields.ListName"]</th>
                            <th>@SharedLocalizer["Lists.Fields.ListType"]</th>
                            <th>@SharedLocalizer["Lists.Fields.Items"]</th>
                            <th>@SharedLocalizer["Lists.Fields.CreatedDate"]</th>
                            <th>@SharedLocalizer["Lists.Fields.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OtherLists)
                        {
                            <tr>
                                <td class="fw-semibold">@item.ListModel!.ListName</td>
                                <td>
                                    <span class="badge rounded-pill @GetListTypeBadgeClass(item.ListModel!.ListType)">@item.ListModel!.ListType</span>
                                </td>
                                    <td><span class="badge rounded-pill bg-primary">@item.ItemCount @SharedLocalizer[item.ItemCount == 1 ? "Common.ItemSingular" : "Common.ItemPlural"]</span></td>
                                <td>@item.ListModel!.CreatedDate.ToString("MMM d, yyyy")</td>
                                <td>
                                    <div class="btn-group btn-group-sm list-action-group" role="group" aria-label="@SharedLocalizer["Lists.ActionsAria"]">
                                        <a asp-action="Manage" asp-route-id="@item.ListModel!.ListID" class="btn btn-outline-primary">@SharedLocalizer["Common.View"]</a>
                                        <a asp-action="Edit" asp-route-id="@item.ListModel!.ListID" class="btn btn-outline-secondary">@SharedLocalizer["Common.Edit"]</a>
                                        <button type="button" class="btn btn-outline-danger delete-list-btn"
                                                data-list-id="@item.ListModel!.ListID"
                                                data-list-name="@item.ListModel!.ListName">@SharedLocalizer["Common.Delete"]</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-md-none">
                @foreach (var item in Model.OtherLists)
                {
                    <div class="card list-mobile-card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <h6 class="mb-0 fw-semibold">@item.ListModel!.ListName</h6>
                                <span class="badge rounded-pill text-bg-primary">@item.ItemCount @SharedLocalizer[item.ItemCount == 1 ? "Common.ItemSingular" : "Common.ItemPlural"]</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="badge rounded-pill @GetListTypeBadgeClass(item.ListModel!.ListType)">@item.ListModel!.ListType</span>
                                <span class="badge rounded-pill badge-theme-neutral">@item.ListModel!.CreatedDate.ToString("MMM d, yyyy")</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Manage" asp-route-id="@item.ListModel!.ListID" class="btn btn-sm btn-outline-primary">@SharedLocalizer["Common.View"]</a>
                                <a asp-action="Edit" asp-route-id="@item.ListModel!.ListID" class="btn btn-sm btn-outline-secondary">@SharedLocalizer["Common.Edit"]</a>
                                <button type="button" class="btn btn-sm btn-outline-danger delete-list-btn"
                                        data-list-id="@item.ListModel!.ListID"
                                        data-list-name="@item.ListModel!.ListName">@SharedLocalizer["Common.Delete"]</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="modal fade" id="deleteListModal" tabindex="-1" aria-labelledby="deleteListModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteListModalLabel">@SharedLocalizer["Common.ConfirmDelete"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Delete" asp-controller="Lists" method="post" id="deleteListForm">
                <div class="modal-body">
                    <p>@SharedLocalizer["Lists.DeletePrompt"] <strong id="deleteListName"></strong>?</p>
                    @Html.Hidden("id", "", new { id = "deleteListId" })
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@SharedLocalizer["Common.Cancel"]</button>
                    <button type="submit" class="btn btn-danger">@SharedLocalizer["Common.Delete"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModalElement = document.getElementById('deleteListModal');
            var deleteModal = new bootstrap.Modal(deleteModalElement);
            var deleteButtons = document.querySelectorAll('.delete-list-btn');
            var deleteListName = document.getElementById('deleteListName');
            var deleteListId = document.getElementById('deleteListId');

            deleteButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    deleteListName.textContent = button.getAttribute('data-list-name') || '@SharedLocalizer["Lists.DeleteFallbackName"]';
                    deleteListId.value = button.getAttribute('data-list-id');
                    deleteModal.show();
                });
            });
        });
    </script>
}