@model ListManager.Models.ListsIndexViewModel

@{
    ViewData["Title"] = SharedLocalizer["Nav.Lists"].Value;
    var hasAnyLists = Model.CircleGroups.Any(g => g.Lists.Any()) || Model.OtherLists.Any();
    var totalLists = Model.CircleGroups.Sum(g => g.Lists.Count()) + Model.OtherLists.Count();
    var inCircle = new ViewDataDictionary(ViewData) { { "ShowCircle", false } };
    var sectionIndex = 0;
}

<div class="page-header">
    <h1 class="page-title">@SharedLocalizer["Nav.Lists"]<span class="page-count">@totalLists</span></h1>
    <a asp-action="Create" class="btn btn-primary page-primary-action" aria-label="@SharedLocalizer["Lists.Create.Title"]">
        <partial name="_Icon" model="@("plus")" />
        <span class="page-primary-label">@SharedLocalizer["Lists.Create.Title"]</span>
    </a>
</div>

@if (hasAnyLists)
{
    <div class="page-toolbar">
        <input type="search" id="entitySearch" class="form-control list-search" placeholder="@SharedLocalizer["Lists.Search.Placeholder"]" aria-label="@SharedLocalizer["Lists.Search.Placeholder"]" />
        <div class="d-flex flex-wrap gap-2 filter-pills" role="group" aria-label="@SharedLocalizer["Lists.Fields.ListType"]">
            <button type="button" class="btn btn-sm rounded-pill filter-pill active" aria-pressed="true" data-entity-filter="all">@SharedLocalizer["Common.All"]</button>
            <button type="button" class="btn btn-sm rounded-pill filter-pill" aria-pressed="false" data-entity-filter="Shopping">Shopping</button>
            <button type="button" class="btn btn-sm rounded-pill filter-pill" aria-pressed="false" data-entity-filter="ToDo">ToDo</button>
            <button type="button" class="btn btn-sm rounded-pill filter-pill" aria-pressed="false" data-entity-filter="WishList">WishList</button>
        </div>
    </div>
}
else
{
    <div class="empty-state text-center p-5 mb-4">
        <h4>@SharedLocalizer["Lists.Empty.Title"]</h4>
        <p class="text-body-secondary">@SharedLocalizer["Lists.Empty.Body"]</p>
        <a asp-action="Create" class="btn btn-primary">@SharedLocalizer["Lists.Create.Title"]</a>
    </div>
}

@foreach (var group in Model.CircleGroups)
{
    var sectionId = $"listSection{sectionIndex++}";
    <section class="list-group-section mb-4">
        <div class="list-section-header d-flex justify-content-between align-items-center">
            <button class="btn list-section-toggle d-flex align-items-center gap-2 fw-semibold min-w-0" type="button" data-bs-toggle="collapse" data-bs-target="#@sectionId" aria-expanded="true" aria-controls="@sectionId">
                <span class="chevron d-inline-flex" aria-hidden="true"><partial name="_Icon" model="@("chevron")" /></span>
                <span class="text-truncate">@group.Circle.Name</span>
                <span class="text-body-secondary fw-normal">(@group.Lists.Count())</span>
            </button>
            <a asp-controller="Circles" asp-action="Manage" asp-route-id="@group.Circle.CircleID" class="btn btn-sm btn-link text-nowrap">@SharedLocalizer["Circles.ViewCircle"]</a>
        </div>
        <div class="collapse show" id="@sectionId">
            @if (!group.Lists.Any())
            {
                <p class="text-body-secondary mt-3 mb-0">@SharedLocalizer["Lists.Circle.Empty"]</p>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-0">
                    @foreach (var item in group.Lists)
                    {
                        <partial name="_ListCard" model="item" view-data="inCircle" />
                    }
                </div>
            }
        </div>
    </section>
}

@if (Model.OtherLists.Any())
{
    var sectionId = $"listSection{sectionIndex++}";
    <section class="list-group-section mb-4">
        <div class="list-section-header">
            <button class="btn list-section-toggle d-flex align-items-center gap-2 fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#@sectionId" aria-expanded="true" aria-controls="@sectionId">
                <span class="chevron d-inline-flex" aria-hidden="true"><partial name="_Icon" model="@("chevron")" /></span>
                <span>@SharedLocalizer["Lists.YourLists"]</span>
                <span class="text-body-secondary fw-normal">(@Model.OtherLists.Count())</span>
            </button>
        </div>
        <div class="collapse show" id="@sectionId">
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-0">
                @foreach (var item in Model.OtherLists)
                {
                    <partial name="_ListCard" model="item" />
                }
            </div>
        </div>
    </section>
}

<p id="entityNoMatches" class="text-center text-body-secondary d-none">@SharedLocalizer["Lists.NoMatches"]</p>
