@model ListManager.Models.List

@{
    ViewData["Title"] = "Edit List";
}

<div class="row">
    <div class="col-md-6">
        <h2>Edit List</h2>
        @using (Html.BeginForm("Edit", "Lists", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ListID)

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group row">
                    @Html.LabelFor(model => model.ListName, "List Name", htmlAttributes: new { @class = "control-label col-sm" })
                    <div class="col-md-10">
                        <small>Please enter the list name.</small>
                        @Html.EditorFor(model => model.ListName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ListName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group row">
                    @Html.LabelFor(model => model.ListType, "List Type", htmlAttributes: new { @class = "control-label col-sm" })
                    <div class="col-md-10">
                        <dl>
                        @foreach (var value in Enum.GetValues(typeof(ListType)))
                            if (value != null)
                            {
                                <dd>
                                    @Html.RadioButtonFor(model => model.ListType, value, htmlAttributes : new { @class = "form-check-input", @id = value })
                                    @Html.Label(value.ToString(), value.ToString(), htmlAttributes: new { @for = value })
                                </dd>
                            }
                        </dl>
                    </div>
                </div>
                <div class="form-group row">
                    @Html.LabelFor(model => model.CircleID, "Circle", htmlAttributes: new { @class = "control-label col-sm" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.CircleID, ViewBag.CircleOptions as SelectList, "None", new { @class = "form-control" })
                        <span class="form-text text-muted">Place this list in one of your circles.</span>
                    </div>
                </div>
                <div class="form-group row mt-2">
                    <div class="col-md-10 offset-sm-2">
                        <div class="form-check">
                            @Html.CheckBoxFor(model => model.StrictStoreLocations, new { @class = "form-check-input", @id = "StrictStoreLocations" })
                            <label class="form-check-label" for="StrictStoreLocations">Only allow predefined store locations for this list</label>
                        </div>
                        <small class="text-muted">When enabled, shoppers must choose an existing location instead of creating new ones.</small>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-offset-2 col-md-2">
                        <input type="submit" value="Save" class="btn btn-primary mb-2" />
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>