@model ListManager.Models.List
@using System.ComponentModel
@using System.Reflection

@{
    ViewData["Title"] = SharedLocalizer["Lists.Create.Title"].Value;

    static string TypeName(ListType type) =>
        typeof(ListType).GetField(type.ToString())?.GetCustomAttribute<DescriptionAttribute>()?.Description ?? type.ToString();

    static string IconClass(ListType type) => type switch
    {
        ListType.Shopping => "list-icon-shopping",
        ListType.ToDo => "list-icon-todo",
        ListType.WishList => "list-icon-wishlist",
        _ => "list-icon-default"
    };
}

<div class="card form-card">
    <div class="card-body p-4">
        <h2 class="card-title">@SharedLocalizer["Lists.Create.Title"]</h2>
        <p class="text-muted mb-4">@SharedLocalizer["Lists.Create.Help"]</p>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ListName" class="form-label">@SharedLocalizer["Lists.Fields.ListName"]</label>
                <input asp-for="ListName" class="form-control" maxlength="100" required />
                <span asp-validation-for="ListName" class="text-danger"></span>
            </div>

            <fieldset class="mb-3">
                <legend class="form-label fs-6">@SharedLocalizer["Lists.Fields.ListType"]</legend>
                <div class="row row-cols-1 row-cols-sm-2 g-2">
                    @foreach (var type in Enum.GetValues<ListType>())
                    {
                        <div class="col">
                            <div class="list-type-option">
                                <input type="radio" class="btn-check" asp-for="ListType" value="@type" id="type-@type" />
                                <label class="form-check-label" for="type-@type">
                                    <span class="list-icon @IconClass(type)"><partial name="_ListTypeIcon" model="(ListType?)type" /></span>
                                    <span>@TypeName(type)</span>
                                </label>
                            </div>
                        </div>
                    }
                </div>
                <span asp-validation-for="ListType" class="text-danger"></span>
            </fieldset>

            <div class="mb-3">
                <label asp-for="CircleID" class="form-label">@SharedLocalizer["Lists.Fields.Circle"]</label>
                <select asp-for="CircleID" asp-items="ViewBag.CircleOptions as SelectList" class="form-select">
                    <option value="">@SharedLocalizer["Common.None"]</option>
                </select>
                <div class="form-text">@SharedLocalizer["Lists.Help.CircleCreate"]</div>
            </div>

            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="StrictStoreLocations" class="form-check-input" />
                    <label asp-for="StrictStoreLocations" class="form-check-label">@SharedLocalizer["StoreLocations.StrictToggle"]</label>
                </div>
                <div class="form-text">@SharedLocalizer["StoreLocations.StrictHelp"]</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@SharedLocalizer["Common.Create"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@SharedLocalizer["Common.Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
