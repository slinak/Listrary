@model ListManager.Models.List

@{
    ViewData["Title"] = "Create a List";
}

<div class="text-center">
    <h1 class="display-4">Create</h1>

</div>
@using (Html.BeginForm("Create", "Lists", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group row">
            @Html.LabelFor(model => model.ListName, "List Name", htmlAttributes: new { @class = "control-label col-sm" })
            <div class="col-md-10">
                <small>Please enter the list name.</small>
                @Html.TextBoxFor(model => model.ListName, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.ListName, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group row">
            @Html.LabelFor(model => model.ListType, "List Type", htmlAttributes: new { @class = "control-label col-sm" })
            <div class="col-md-10">
                <dl>
                @foreach (var value in Enum.GetValues(typeof(ListType)))
                    if (value != null)
                    {
                        <dd>
                            @Html.RadioButtonFor(model => model.ListType, value, htmlAttributes : new { @class = "form-check-input", @id = value })
                            @Html.Label(value.ToString(), value.ToString(), htmlAttributes: new { @for = value })
                        </dd>
                    }
                </dl>
            </div>
        </div>
        <div class="form-group row">
            @Html.LabelFor(model => model.CircleID, "Circle", htmlAttributes: new { @class = "control-label col-sm" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.CircleID, ViewBag.CircleOptions as SelectList, "None", new { @class = "form-control" })
                <span class="form-text text-muted">Add this list to one of your circles.</span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-offset-2 col-md-2">
                <input type="submit" value="Create" class="btn btn-primary mb-2" />
            </div>
        </div>
    </div>
}