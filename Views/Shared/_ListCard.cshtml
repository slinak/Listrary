@model ListManager.Models.ListViewItemModel
@using ListManager.Models

@{
    var list = Model.ListModel!;
    var canEdit = ViewData["CanEdit"] as bool? ?? true;
    var showCircle = ViewData["ShowCircle"] as bool? ?? true;
    var typeKey = list.ListType.ToString();
    var (iconClass, badgeClass) = list.ListType switch
    {
        ListType.Shopping => ("list-icon-shopping", "badge-listtype-shopping"),
        ListType.ToDo => ("list-icon-todo", "badge-listtype-todo"),
        ListType.WishList => ("list-icon-wishlist", "badge-listtype-wishlist"),
        _ => ("list-icon-default", "badge-listtype-default")
    };
    var hiddenCount = Model.RemainingCount - Model.UpcomingItems.Count();
}

<div class="col entity-col" data-filter-name="@list.ListName" data-filter-tags="@typeKey">
    <div class="card list-card h-100 position-relative">
        <div class="card-body d-flex flex-column">
            <div class="d-flex align-items-center gap-3">
                <span class="list-icon @iconClass" aria-hidden="true"><partial name="_ListTypeIcon" model="list.ListType" /></span>
                <div class="flex-grow-1 min-w-0">
                    <h5 class="card-title mb-1 text-truncate">
                        <a asp-controller="Lists" asp-action="Manage" asp-route-id="@list.ListID" class="stretched-link text-decoration-none list-card-link">@list.ListName</a>
                    </h5>
                    <span class="badge rounded-pill @badgeClass">@typeKey</span>
                </div>
                @if (canEdit)
                {
                    <div class="dropdown list-card-menu">
                        <button class="btn btn-sm btn-link text-body-secondary p-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@SharedLocalizer["Common.MoreActions"]">
                            <partial name="_Icon" model="@("dots")" />
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Lists" asp-action="Edit" asp-route-id="@list.ListID">@SharedLocalizer["Common.Edit"]</a></li>
                            <li>
                                <button type="button" class="dropdown-item text-danger confirm-delete-btn"
                                        data-delete-url="@Url.Action("Delete", "Lists", new { id = list.ListID })"
                                        data-delete-prompt="@SharedLocalizer["Lists.DeletePrompt"]"
                                        data-delete-name="@list.ListName">@SharedLocalizer["Common.Delete"]</button>
                            </li>
                        </ul>
                    </div>
                }
            </div>

            @if (Model.UpcomingItems.Any())
            {
                <ul class="card-preview">
                    @foreach (var name in Model.UpcomingItems)
                    {
                        <li><span class="preview-dot" aria-hidden="true"></span><span>@name</span></li>
                    }
                    @if (hiddenCount > 0)
                    {
                        <li class="more">@SharedLocalizer["Lists.MoreToGo", hiddenCount]</li>
                    }
                </ul>
            }
            else if (Model.ItemCount > 0)
            {
                <p class="small text-body-secondary mb-0">@SharedLocalizer["Lists.AllDone"]</p>
            }

            <div class="mt-auto">
                <div class="progress list-progress" role="progressbar" aria-label="@SharedLocalizer["Lists.Progress", Model.CompletedCount, Model.ItemCount]" aria-valuenow="@Model.Percent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width:@Model.Percent%"></div>
                </div>
                <div class="small text-body-secondary d-flex justify-content-between gap-2">
                    <span class="text-truncate">
                        @if (showCircle && list.Circle != null)
                        {
                            <span class="me-1" aria-hidden="true"><partial name="_Icon" model="@("circles")" /></span>@list.Circle.Name<span> · </span>
                        }
                        @SharedLocalizer["Lists.Progress", Model.CompletedCount, Model.ItemCount]
                    </span>
                    <time class="text-nowrap" datetime="@list.LastUpdatedDate.ToString("o")" data-relative-time>@list.LastUpdatedDate.ToString("MMM d, yyyy")</time>
                </div>
            </div>
        </div>
    </div>
</div>
