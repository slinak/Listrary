@model ListManager.Models.ListViewItemModel
@using ListManager.Models

@{
    var list = Model.ListModel!;
    var canEdit = ViewData["CanEdit"] as bool? ?? true;
    var typeKey = list.ListType.ToString();
    var (iconClass, badgeClass) = list.ListType switch
    {
        ListType.Shopping => ("list-icon-shopping", "badge-listtype-shopping"),
        ListType.ToDo => ("list-icon-todo", "badge-listtype-todo"),
        ListType.WishList => ("list-icon-wishlist", "badge-listtype-wishlist"),
        _ => ("list-icon-default", "badge-listtype-default")
    };
    var percent = Model.ItemCount == 0 ? 0 : (int)Math.Round(100.0 * Model.CompletedCount / Model.ItemCount);
}

<div class="col list-card-col" data-list-name="@list.ListName" data-list-type="@typeKey">
    <div class="card list-card h-100 position-relative">
        <div class="card-body d-flex flex-column">
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="list-icon @iconClass" aria-hidden="true">
                    @switch (list.ListType)
                    {
                        case ListType.Shopping:
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4"/></svg>
                            break;
                        case ListType.ToDo:
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/><path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z"/></svg>
                            break;
                        case ListType.WishList:
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path d="m8 2.748-.717-.737C5.6.281 2.514.878 1.4 3.053c-.523 1.023-.641 2.5.314 4.385.92 1.815 2.834 3.989 6.286 6.357 3.452-2.368 5.365-4.542 6.286-6.357.955-1.886.838-3.362.314-4.385C13.486.878 10.4.28 8.717 2.01z"/></svg>
                            break;
                        default:
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5M3.854 2.146a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708L2 3.293l1.146-1.147a.5.5 0 0 1 .708 0"/></svg>
                            break;
                    }
                </span>
                <div class="flex-grow-1 min-w-0">
                    <h5 class="card-title mb-1 text-truncate">
                        <a asp-controller="Lists" asp-action="Manage" asp-route-id="@list.ListID" class="stretched-link text-decoration-none list-card-link">@list.ListName</a>
                    </h5>
                    <span class="badge rounded-pill @badgeClass">@typeKey</span>
                </div>
                @if (canEdit)
                {
                    <div class="dropdown list-card-menu">
                        <button class="btn btn-sm btn-link text-body-secondary p-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@SharedLocalizer["Common.MoreActions"]">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3"/></svg>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Lists" asp-action="Edit" asp-route-id="@list.ListID">@SharedLocalizer["Common.Edit"]</a></li>
                            <li>
                                <button type="button" class="dropdown-item text-danger delete-list-btn"
                                        data-list-id="@list.ListID"
                                        data-list-name="@list.ListName">@SharedLocalizer["Common.Delete"]</button>
                            </li>
                        </ul>
                    </div>
                }
            </div>

            <div class="mb-3">
                <div class="progress list-progress" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width:@percent%"></div>
                </div>
                <small class="text-body-secondary">@SharedLocalizer["Lists.Progress", Model.CompletedCount, Model.ItemCount]</small>
            </div>

            <div class="mt-auto small text-body-secondary d-flex justify-content-between">
                <span>@Model.ItemCount @SharedLocalizer[Model.ItemCount == 1 ? "Common.ItemSingular" : "Common.ItemPlural"]</span>
                <span>@SharedLocalizer["Common.Updated"] <time datetime="@list.LastUpdatedDate.ToString("o")" data-relative-time>@list.LastUpdatedDate.ToString("MMM d, yyyy")</time></span>
            </div>
        </div>
    </div>
</div>
