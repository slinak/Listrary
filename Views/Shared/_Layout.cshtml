@{
    var isSignedIn = User.Identity?.IsAuthenticated ?? false;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    // Each area's pages, including list items, highlight their own nav entry.
    var navSection = currentController switch
    {
        "Lists" or "ListItem" => "Lists",
        "Circles" => "Circles",
        "Recipes" => "Recipes",
        _ => string.Empty
    };
    var navItems = new[]
    {
        (Key: "Lists", Icon: "lists", Label: SharedLocalizer["Nav.Lists"].Value),
        (Key: "Circles", Icon: "circles", Label: SharedLocalizer["Nav.Circles"].Value),
        (Key: "Recipes", Icon: "recipes", Label: SharedLocalizer["Nav.Recipes"].Value)
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - @SharedLocalizer["App.Title"]</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="~/images/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icons/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/icons/apple-touch-icon.png" />
    <link rel="mask-icon" href="~/images/icons/safari-pinned-tab.svg" color="#0FAF9F" />
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="msapplication-config" content="@Url.Content("~/browserconfig.xml")" />
    <meta name="theme-color" content="#0FAF9F" />
    <meta property="og:title" content="Listrary" />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Url.Content("~/images/icons/og-image.png")}")" />
    <meta name="twitter:card" content="summary_large_image" />
    <script>(function(){var t=localStorage.getItem('listrary-theme');if(t==='dark')document.documentElement.setAttribute('data-bs-theme','dark');}());</script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ListManager.styles.css" asp-append-version="true" />
</head>
<body class="@(isSignedIn ? "app-shell" : "")" data-section="@navSection.ToLowerInvariant()">
    @if (isSignedIn)
    {
        <aside class="app-sidebar d-none d-md-flex" aria-label="@SharedLocalizer["Nav.Main"]">
            <a class="app-sidebar-brand" asp-controller="Lists" asp-action="Index" title="@SharedLocalizer["App.Tagline"]">
                <img src="~/images/icons/favicon.svg" alt="" width="28" height="28" class="app-logo" />
                <span class="app-brand-name">@SharedLocalizer["App.Title"]</span>
            </a>
            <nav class="d-flex flex-column gap-1">
                @foreach (var item in navItems)
                {
                    var active = navSection == item.Key;
                    <a class="app-sidebar-link app-accent-@item.Key.ToLowerInvariant() @(active ? "active" : "")" aria-current="@(active ? "page" : null)" asp-controller="@item.Key" asp-action="Index">
                        <span class="app-sidebar-icon"><partial name="_Icon" model="@item.Icon" /></span>
                        <span>@item.Label</span>
                    </a>
                }
            </nav>
            <div class="app-sidebar-circles">
                @await Component.InvokeAsync("SidebarCircles")
            </div>
            <div class="mt-auto pt-3">
                <partial name="_AccountMenu" model="@("dropup")" />
            </div>
        </aside>

        <header class="app-topbar d-md-none">
            <a class="d-flex align-items-center gap-2 text-decoration-none" asp-controller="Lists" asp-action="Index">
                <img src="~/images/icons/favicon.svg" alt="" width="26" height="26" class="app-logo" />
                <span class="app-brand-name">@SharedLocalizer["App.Title"]</span>
            </a>
            <partial name="_AccountMenu" model="@("dropdown")" />
        </header>
    }
    else
    {
        <header>
            <nav class="navbar app-navbar navbar-expand-sm mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Lists" asp-action="Index" title="@SharedLocalizer["App.Tagline"]">
                        <img src="~/images/icons/favicon.svg" alt="" width="32" height="32" class="app-logo" />
                        <span class="app-brand-name">@SharedLocalizer["App.Title"]</span>
                    </a>
                    <div class="ms-auto">
                        @await Html.PartialAsync("_LoginPartial")
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="app-main">
        <div class="container-xl app-container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
        <footer class="footer text-muted">
            <div class="container-xl">&copy; 2026 - @SharedLocalizer["App.Title"]</div>
        </footer>
    </div>

    @if (isSignedIn)
    {
        <nav class="app-tabbar d-md-none" aria-label="@SharedLocalizer["Nav.Main"]">
            @foreach (var item in navItems)
            {
                var active = navSection == item.Key;
                <a class="app-tabbar-link @(active ? "active" : "")" aria-current="@(active ? "page" : null)" asp-controller="@item.Key" asp-action="Index">
                    <partial name="_Icon" model="@item.Icon" />
                    <span>@item.Label</span>
                </a>
            }
        </nav>
    }

    <partial name="_ConfirmDeleteModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
