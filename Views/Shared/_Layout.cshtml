@{
    var isSignedIn = User.Identity?.IsAuthenticated ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @SharedLocalizer["App.Title"]</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="~/images/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icons/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/icons/apple-touch-icon.png" />
    <link rel="mask-icon" href="~/images/icons/safari-pinned-tab.svg" color="#0FAF9F" />
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="msapplication-config" content="@Url.Content("~/browserconfig.xml")" />
    <meta name="theme-color" content="#0FAF9F" />
    <meta property="og:title" content="Listrary" />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Url.Content("~/images/icons/og-image.png")}")" />
    <meta name="twitter:card" content="summary_large_image" />
    <script>(function(){var t=localStorage.getItem('listrary-theme');if(t==='dark')document.documentElement.setAttribute('data-bs-theme','dark');}());</script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ListManager.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Lists" asp-action="Index">@SharedLocalizer["App.Tagline"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="@SharedLocalizer["Nav.Toggle"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <!-- Create link moved to Lists page header -->
                        @if (isSignedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Lists" asp-action="Index">@SharedLocalizer["Nav.Lists"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Circles" asp-action="Index">@SharedLocalizer["Nav.Circles"]</a>
                            </li>
                        }
                    </ul>
                    @await Html.PartialAsync("_LoginPartial")
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - @SharedLocalizer["App.Title"]
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
