@model ErrorViewModel
@{
    ViewData["Title"] = SharedLocalizer["Error.Title"].Value;
}

<h1 class="text-danger">@SharedLocalizer["Error.Heading"]</h1>
<h2 class="text-danger">@SharedLocalizer["Error.Subheading"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@SharedLocalizer["Error.RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@SharedLocalizer["Error.DevelopmentMode"]</h3>
<p>
    @SharedLocalizer["Error.DevelopmentHelp1"]
</p>
<p>
    <strong>@SharedLocalizer["Error.DevelopmentWarning"]</strong>
    @SharedLocalizer["Error.DevelopmentHelp2"]
</p>
