@model ListManager.Models.ListItem

@{
    ViewData["Title"] = "Edit Item";
    int listID = ViewBag.ListID;
    bool strictStoreLocations = ViewBag.StrictStoreLocations != null && (bool)ViewBag.StrictStoreLocations;
}

<div class="row">
    <div class="col-md-6">
        <h2>Edit Item</h2>
        @using (Html.BeginForm("Edit", "ListItem", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ListItemID)
            <input type="hidden" name="listID" value="@ViewBag.ListID" />

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group row">
                    @Html.LabelFor(model => model.ItemName, "Item Name", htmlAttributes: new { @class = "control-label col-sm" })
                    <div class="col-md-10">
                        <small>Please enter the item name.</small>
                        @Html.EditorFor(model => model.ItemName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ItemName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group row">
                    @Html.LabelFor(model => model.ItemDetails, "Details", htmlAttributes: new { @class = "control-label col-sm" })
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.ItemDetails, 4, 0, new { @class = "form-control", placeholder = "Optional details" })
                        @Html.ValidationMessageFor(model => model.ItemDetails, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group row">
                    @Html.LabelFor(model => model.StoreLocation, "Store Location", htmlAttributes: new { @class = "control-label col-sm" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.StoreLocation, new { @class = "form-control", placeholder = "Aisle 5, Produce, Frozen", @list = "storeLocationSuggestions" })
                        <datalist id="storeLocationSuggestions"></datalist>
                        @if (strictStoreLocations)
                        {
                            <small class="text-muted">This list only accepts predefined store locations.</small>
                        }
                        @Html.ValidationMessageFor(model => model.StoreLocation, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-offset-2 col-md-10">
                        <div class="form-check">
                            @Html.CheckBoxFor(model => model.IsCompleted, new { @class = "form-check-input", @id = "IsCompleted" })
                            <label class="form-check-label" for="IsCompleted">Mark as Completed</label>
                        </div>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-offset-2 col-md-2">
                        <input type="submit" value="Save" class="btn btn-primary mb-2" />
                        <a asp-action="Manage" asp-controller="Lists" asp-route-id="@listID" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var itemNameInput = document.querySelector('input[name="ItemName"]');
            var storeLocationInput = document.querySelector('input[name="StoreLocation"]');
            var storeLocationDatalist = document.getElementById('storeLocationSuggestions');
            var listID = @ViewBag.ListID;
            var strictStoreLocations = @strictStoreLocations.ToString().ToLowerInvariant();
            var debounceTimer;

            if (!itemNameInput || !storeLocationInput || !storeLocationDatalist) {
                return;
            }

            function renderSuggestions(suggestions) {
                storeLocationDatalist.innerHTML = '';
                suggestions.forEach(function (value) {
                    var option = document.createElement('option');
                    option.value = value;
                    storeLocationDatalist.appendChild(option);
                });

                if (strictStoreLocations && suggestions.length > 0 && storeLocationInput.value.trim().length === 0) {
                    storeLocationInput.value = suggestions[0];
                }
            }

            function fetchSuggestions() {
                var itemName = itemNameInput.value.trim();
                var query = storeLocationInput.value.trim();
                if (itemName.length === 0) {
                    storeLocationDatalist.innerHTML = '';
                    return;
                }

                var url = '/ListItem/GetStoreLocationSuggestions?listID=' + listID + '&itemName=' + encodeURIComponent(itemName) + '&query=' + encodeURIComponent(query);
                fetch(url)
                    .then(response => response.json())
                    .then(renderSuggestions)
                    .catch(error => console.error('Error fetching store location suggestions:', error));
            }

            itemNameInput.addEventListener('blur', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(fetchSuggestions, 100);
            });

            storeLocationInput.addEventListener('focus', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(fetchSuggestions, 100);
            });

            storeLocationInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(fetchSuggestions, 200);
            });
        });
    </script>
}
