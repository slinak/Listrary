@page
@model LogoutModel
@{
    ViewData["Title"] = SharedLocalizer["Account.Logout"].Value;
}

<header>
    <h1>@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">@SharedLocalizer["Account.Logout.Click"]</button>
            </form>
        }
        else
        {
            <p>@SharedLocalizer["Account.Logout.Success"]</p>
        }
    }
</header>
